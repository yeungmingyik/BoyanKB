[Unit]
Description=RustDesk relay server
Wants=network-online.target
Requires=rustdesk-firewall.service
After=network-online.target rustdesk-firewall.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=rustdesk
Group=rustdesk
Slice=rustdesk.slice
WorkingDirectory=/opt/rustdesk/data
EnvironmentFile=/opt/rustdesk/config/.env
ExecStart=/opt/rustdesk/current/hbbr
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/rustdesk/data
InaccessiblePaths=/opt/boyankb
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
LogNamespace=rustdesk
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
