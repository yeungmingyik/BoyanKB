FROM golang:1.26-bookworm AS builder
WORKDIR /app
ENV GOMAXPROCS=3 GOFLAGS=-p=3 CARGO_BUILD_JOBS=2
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends libsqlite3-dev && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
COPY go.mod go.sum ./
COPY third_party/anydoc-go ./third_party/anydoc-go
COPY scripts/build-anydoc-lib.sh ./scripts/build-anydoc-lib.sh
RUN --mount=type=cache,target=/go/pkg/mod go mod download -x
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/usr/local/cargo/git bash scripts/build-anydoc-lib.sh
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build go test -ldflags='-X google.golang.org/protobuf/reflect/protoregistry.conflictPolicy=warn' ./internal/branding ./internal/config ./internal/middleware ./internal/datasource/connector/feishu/core ./internal/datasource/connector/feishu/wiki -count=1
ARG BRANDING_COMMIT=local-branding
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build VERSION=v0.8.2-boyankb COMMIT_ID=${BRANDING_COMMIT} make build-prod GO_BUILD_TAGS=anydoc

FROM wechatopenai/weknora-app:v0.8.2@sha256:bc8a534799fcb54045100daf4bc5db86270b38ae45c5f761c410c50b4dcd6cdc
COPY --from=builder --chown=appuser:appuser /app/WeKnora /app/WeKnora
COPY --chown=appuser:appuser branding/brand.json /app/branding/brand.json
COPY --chown=appuser:appuser branding/prompt_templates/agent_system_prompt.yaml /app/config/prompt_templates/agent_system_prompt.yaml
COPY --chown=appuser:appuser branding/prompt_templates/system_prompt.yaml /app/config/prompt_templates/system_prompt.yaml
COPY --chown=appuser:appuser branding/prompt_templates/context_template.yaml /app/config/prompt_templates/context_template.yaml
COPY --chown=appuser:appuser branding/prompt_templates/rewrite.yaml /app/config/prompt_templates/rewrite.yaml
COPY --chown=appuser:appuser branding/prompt_templates/fallback.yaml /app/config/prompt_templates/fallback.yaml
COPY --chown=appuser:appuser branding/prompt_templates/intent_prompts.yaml /app/config/prompt_templates/intent_prompts.yaml
COPY --chown=appuser:appuser presets/boyan/v1/manifest.json presets/boyan/v1/common-rules.md presets/boyan/v1/workflow-guide.md /app/presets/boyan/v1/
COPY --chown=appuser:appuser presets/boyan/v1/agents /app/presets/boyan/v1/agents
COPY --chown=appuser:appuser skills/boyan /app/skills/boyan
COPY --chown=appuser:appuser migrations /app/migrations
COPY LICENSE /usr/share/licenses/upstream/LICENSE
ENV BRANDING_CONFIG=/app/branding/brand.json
LABEL io.weknora.feishu-guard="1" io.boyankb.branding="1"
